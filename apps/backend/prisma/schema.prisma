generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PokemonCard {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model ItemList {
  id        Int      @id @default(autoincrement())
  page      String
  title     String
  createdAt DateTime @default(now())
}